<%- include("partials/head.ejs") %>

<div class="titulo-pagina">
    <h1> <%= tituloAccion %> </h1>
    <p> <%= descripcion %> </p>
</div>

<main>
    <h2> <%= about %></h2>
    <!-- 
    =================================================================
        Enviando Formularios con HTML nativo (Evitamos uso de js)
    =================================================================
    En action="" Mandamos la url del endpoint /login 
    En method="" Determinamos si enviamos con GET o con POST la informacion
    Gracias al Middleware: 
        app.use(express.urlencoded({
            extended: true
            })
        );
    Nuestro endpoint recibira esta info (no JSON) como objeto JS, es decir, el middleware parseara automaticamente el tipo de info que envia <form>
    -->
    <form action="/login" method="POST" id="loginUser-form">
        <!-- TO DO: Introducir campos regex para validar los datos que enviamos -->
        <!-- Mail del usuario -->
        <label for="emailUser">Email</label>
        <input type="email" name="email" id="emailUser" required>

        <!-- Contraseña del usuario -->
        <label for="passwordUser">Contraseña</label>
        <input type="password" name="password" id="passwordUser" required>

        <!-- Boton loguear -->
        <input type="submit" value="Login">
    </form>

    <% if(typeof error !== "undefined"){ %>
            <p class="mensaje mensaje-error"><%= error %></p>  
   <% } %>
<!-- Boton de login rapido -->
<button type="button" id="btnLoginRapido">Login rápido</button>

<script>
    document.getElementById('btnLoginRapido').addEventListener('click', () => {
        document.getElementById('emailUser').value = 'admin@gmail.com';
        document.getElementById('passwordUser').value = '12345';
    });
</script>

</main>

<%- include("partials/footer.ejs") %>