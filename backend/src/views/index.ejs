<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>
<main>
    <h2> <%= about %> </h2>
    <div id="contenedor-productos">
        <% activeProductsArray.forEach((producto) =>  { %>  <!-- Recibimos el array de productos y lo iteramos en la plantilla -->
            <div class="card-producto"> 
                <img src="<%= producto.pathImagen%>" alt="<%=producto.nombre%>">
                <h4> <%= producto.nombre %> </h4>
                <p>Id:  <%= producto.id %> </p>
                <p>$ <%= producto.precio %> </p>
                <p>Stock: <%= producto.stock%></p>
                <p>Activo: <%= producto.activo%></p>
            </div> <!-- Estamos haciendo la accion del innerHTML-->
        <% }); %> 
    </div>
    <h2>Productos inactivos (sin stock)</h2>

    <div id="contenedor-productos-inactivos">
        <% if(nonActiveProductsArray.length === 0)  { %>
            <p>Actualmente no hay productos inactivos</p>
        <% } %>

        <% nonActiveProductsArray.forEach((producto) =>  { %>  <!-- Recibimos el array de productos y lo iteramos en la plantilla -->
            <div class="card-producto"> 
                <img src="<%= producto.pathImagen%>" alt="<%=producto.nombre%>">
                <h4> <%= producto.nombre %> </h4>
                <p>Id:  <%= producto.id %> </p>
                <p>$ <%= producto.precio %> </p>
                <p>Stock: <%= producto.stock%></p>
            </div> <!-- Estamos haciendo la accion del innerHTML-->
        <% }); %> 
    </div>

</main>
<script src="/js/header.js"></script>
<%- include("partials/footer.ejs") %>