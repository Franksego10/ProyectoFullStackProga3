<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>
<main>
    <h2> <%= about %> </h2>
    <div id="contenedor-productos">
        <% productsArray.forEach((producto) =>  { %>  <!-- Recibimos el array de productos y lo iteramos en la plantilla -->
            <div class="card-producto"> 
                <img src="<%= producto.pathImagen%>" alt="<%=producto.nombre%>">
                <h4> <%= producto.nombre %> </h4>
                <p>Id:  <%= producto.id %> </p>
                <p>$ <%= producto.precio %> </p>
            </div> <!-- Estamos haciendo la accion del innerHTML-->
        <% }); %> 
    </div>
</main>

