<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>
    <main>
        <h2> <%= about %></h2>

        <form id="postProduct-form">
            <!-- Nombre producto -->
            <label for="nameProd">Nombre del producto</label>
            <input type="text" name="nombre" id="nameProd" required>

            <!-- Descripcion -->
            <label for="nameProd">Descripcion</label>
            <input type="text" name="descripcion" id="descripcionProd" required>

            <!-- Precio -->
            <label for="priceProd">Precio</label>
            <input type="number" name="precio" id="priceProd" required>

            <!-- stock -->
            <label for="stockProd">Stock inicial</label>
            <input type="number" name="stock" id="stockProd" required>
            
            <!-- Activo -->
            <label hidden for="activeProd">Activo</label>
            
            <select hidden name="active" id="activeProd">
                <option  value="1">activo</option>
            </select>
            
            <!-- categoria -->
            <label for="nameProd">Categoria</label>
            <input type="text" name="categoria" id="categoriaProd" required>

            <!-- path imagen -->
            <label for="nameProd">Direccion de enlace de la imagen</label>
            <input type="text" name="imagen" id="pathProd" required>

            <input type="submit" value="Crear producto">

        </form>

        <!-- Formulario para crear usuario -->

        <h2> Crear nuevo usuario </h2>

        <form id="postUser-form">
            <!-- Nombre producto -->
            <label for="nameUser">Nombre</label>
            <input type="text" name="nombre" id="nameUser" required>

            <!-- Descripcion -->
            <label for="emailUser">Email</label>
            <input type="text" name="email" id="emailUser" required>

            <!-- Precio -->
            <label for="passwordUser">Contraseña</label>
            <input type="text" name="password" id="passwordUser" required>

            <select hidden name="es_admin" id="esAdmin">
                <option value="1">Admin</option>
            </select>

            <input type="submit" value="Crear usuario">

        </form>

        <div id="contenedor-productos">
            <!-- Aca ira nuestro mensaje de exito o error -->
        </div>


    </main>

    <script src="/js/header.js"></script>
    <script src="/js/post.js"></script>
<%- include("partials/footer.ejs") %>